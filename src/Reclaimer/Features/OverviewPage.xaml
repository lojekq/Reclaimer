<Page x:Class="Reclaimer.Features.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Reclaimer.Shell"
      xmlns:f="clr-namespace:Reclaimer.Features"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="1000">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Overview}" />
            <ui:TextBlock Appearance="Secondary" Text="{l:T Overview.Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <ui:InfoBar x:Name="RootsBar" Severity="Informational" IsClosable="False" Margin="0,0,0,12"
                        Title="{l:T Overview.NoRoots.Title}" Message="{l:T Overview.NoRoots.Message}">
                <ui:Button x:Name="AddRootsButton" Content="{l:T Overview.AddRoots}" Icon="{ui:SymbolIcon FolderAdd24}" />
            </ui:InfoBar>

            <ui:Card Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="ScanButton" Appearance="Primary" Content="{l:T Scan.Button}" Icon="{ui:SymbolIcon Search24}"
                               MinWidth="140" IsEnabled="{Binding Idle}" />
                    <ui:Button x:Name="CancelButton" Grid.Column="1" Margin="8,0,0,0" Content="{l:T Common.Cancel}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" />
                        <StackPanel>
                            <ui:TextBlock Text="{Binding ScanText}" TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock x:Name="LastScanText" FontTypography="Caption" Appearance="Secondary" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="{l:T Overview.CanReturn}" Margin="0,4,0,8" />
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:TileView}">
                        <ui:CardAction Margin="0,0,8,0" Padding="16,14" Icon="{Binding Icon}" IsChevronVisible="False"
                                       Click="Tile_Click" Tag="{Binding Category}">
                            <StackPanel>
                                <ui:TextBlock Text="{Binding Title}" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                                <ui:TextBlock Text="{Binding Sum}" FontTypography="Subtitle" />
                                <ui:TextBlock Text="{Binding Count}" FontTypography="Caption" Appearance="Tertiary" />
                            </StackPanel>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:TextBlock FontTypography="BodyStrong" Text="{l:T Overview.Volumes}" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:VolumeView}">
                        <ui:Card Margin="0,0,0,6" Padding="16,12">
                            <StackPanel>
                                <Grid>
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Text}" Appearance="Secondary" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,6" />
                                <ui:TextBlock Text="{Binding QuarantineText}" FontTypography="Caption" Appearance="Secondary" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
