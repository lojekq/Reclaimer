<Page x:Class="Reclaimer.Features.DisksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Reclaimer.Shell"
      xmlns:f="clr-namespace:Reclaimer.Features"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,16">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Disks}" />
            <ui:TextBlock Appearance="Secondary" Text="{l:T Disks.Subtitle}" TextWrapping="Wrap" Margin="0,4,0,12" />
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:Disk}">
                        <ui:Card Margin="0,0,0,6" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel ToolTip="{Binding Path}" Margin="0,0,12,0">
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Path}" FontTypography="Caption" Appearance="Tertiary" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ui:TextBlock Grid.Column="1" Text="{Binding SizeText}" FontTypography="BodyStrong" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{l:T Disks.Sparse}" FontTypography="Caption" Appearance="Tertiary" />
                                    <ui:TextBlock Text="{Binding SparseText}" />
                                </StackPanel>
                                <ui:TextBlock Grid.Column="3" Text="{Binding RunningText}" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="4" Content="{l:T Disks.Compact}" Icon="{ui:SymbolIcon ArrowMinimize24}" Click="Compact_Click" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:TextBlock x:Name="EmptyText" Text="{l:T Disks.Empty}" Appearance="Tertiary" Margin="0,8,0,8" TextWrapping="Wrap" />

            <ui:TextBlock FontTypography="BodyStrong" Text="Docker" Margin="0,16,0,8" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DockerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type f:DockerRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding Type}" />
                                    <ui:TextBlock Grid.Column="1" Text="{Binding Size}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Grid.Column="2" Text="{Binding ReclaimableText}" Appearance="Secondary" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock Text="{Binding DockerText}" Appearance="Secondary" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button x:Name="PruneBuildButton" Content="{l:T Docker.PruneBuild}" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,6" IsEnabled="{Binding Idle}" />
                        <ui:Button x:Name="PruneImagesButton" Content="{l:T Docker.PruneImages}" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,6" IsEnabled="{Binding Idle}" />
                    </WrapPanel>
                    <ui:TextBlock Text="{l:T Docker.Note}" FontTypography="Caption" Appearance="Tertiary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
