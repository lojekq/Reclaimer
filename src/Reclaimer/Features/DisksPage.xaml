<Page x:Class="Reclaimer.Features.DisksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Reclaimer.Shell"
      xmlns:f="clr-namespace:Reclaimer.Features"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Disks}" />
        <ui:TextBlock Grid.Row="1" Appearance="Secondary" Text="{l:T Disks.Subtitle}" TextWrapping="Wrap" Margin="0,4,0,12" />
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Disks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type f:Disk}">
                    <ui:Card Margin="0,0,0,6" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel ToolTip="{Binding Path}">
                                <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{Binding Path}" FontTypography="Caption" Appearance="Tertiary" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" Text="{Binding SizeText}" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <ui:TextBlock Text="{l:T Disks.Sparse}" FontTypography="Caption" Appearance="Tertiary" />
                                <ui:TextBlock Text="{Binding SparseText}" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="3" Text="{Binding RunningText}" VerticalAlignment="Center" />
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:TextBlock x:Name="EmptyText" Grid.Row="2" Text="{l:T Disks.Empty}" Appearance="Tertiary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
</Page>
