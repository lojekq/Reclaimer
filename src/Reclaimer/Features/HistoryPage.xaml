<Page x:Class="Reclaimer.Features.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Reclaimer.Shell"
      xmlns:f="clr-namespace:Reclaimer.Features"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.History}" />
        <ui:TextBlock Grid.Row="1" Appearance="Secondary" Text="{l:T History.Subtitle}" TextWrapping="Wrap" Margin="0,4,0,12" />
        <ListBox x:Name="List" Grid.Row="2" ItemsSource="{Binding History}" SelectionMode="Single" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type f:HistoryRow}">
                    <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{Binding WhenText}" Appearance="Secondary" VerticalAlignment="Center" />
                            <ui:TextBlock Grid.Column="1" Text="{Binding ActionText}" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding PathText}">
                                <ui:TextBlock Text="{Binding NameText}" TextTrimming="CharacterEllipsis" />
                                <ui:TextBlock Text="{Binding PathText}" FontTypography="Caption" Appearance="Tertiary" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" />
                            <ui:TextBlock x:Name="R" Grid.Column="4" Text="{Binding ResultText}" Appearance="Secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Failed}" Value="True">
                            <Setter TargetName="R" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ui:TextBlock x:Name="EmptyText" Grid.Row="2" Text="{l:T History.Empty}" Appearance="Tertiary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
</Page>
