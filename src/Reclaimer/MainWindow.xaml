<ui:FluentWindow x:Class="Reclaimer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Reclaimer.Shell"
                 xmlns:f="clr-namespace:Reclaimer.Features"
                 Title="{x:Static l:AppInfo.DisplayName}" Width="1100" Height="700" MinWidth="720" MinHeight="480"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static l:AppInfo.DisplayName}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="12,0,12,0">
            <ui:InfoBar x:Name="ElevatedBar" Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                        Title="{l:T Elevated.Title}" Message="{l:T Elevated.Message}" />
            <ui:InfoBar x:Name="UpdateBar" Severity="Informational" Margin="0,0,0,8" Title="{l:T Update.Title}">
                <ui:HyperlinkButton x:Name="UpdateLink" Content="{l:T Update.Open}" Padding="0" />
            </ui:InfoBar>
        </StackPanel>

        <!-- App pages go into MenuItems; TargetPageTag is the page id for the page flag and Navigate("id") -->
        <ui:NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False" OpenPaneLength="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T Page.Overview}" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type f:OverviewPage}" TargetPageTag="overview" />
                <ui:NavigationViewItem Content="{l:T Page.Findings}" Icon="{ui:SymbolIcon Search24}"
                                       TargetPageType="{x:Type f:FindingsPage}" TargetPageTag="findings" />
                <ui:NavigationViewItem Content="{l:T Page.Quarantine}" Icon="{ui:SymbolIcon Archive24}"
                                       TargetPageType="{x:Type f:QuarantinePage}" TargetPageTag="quarantine" />
                <ui:NavigationViewItem Content="{l:T Page.Disks}" Icon="{ui:SymbolIcon Storage24}"
                                       TargetPageType="{x:Type f:DisksPage}" TargetPageTag="disks" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T Page.Settings}" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type l:SettingsPage}" TargetPageTag="settings" />
                <ui:NavigationViewItem Content="{l:T Page.About}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type l:AboutPage}" TargetPageTag="about" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- In-window dialogs (Features/Dialog.cs): screenshots and GIFs capture them with the window -->
        <Border x:Name="DialogHost" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="48" MaxWidth="820"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter x:Name="DialogContent" />
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
